# Purpose: Example environment variables for the Next.js production dashboard.
NEXT_PUBLIC_APP_NAME=Ichnoscope

# Live Render backend URL (e.g. https://ichnoscope-backend.onrender.com)
# When set, browser API requests will query this backend directly.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000

ADMIN_AUTH_TOKEN=secret-admin-token-placeholder
REQUIRE_ADMIN_AUTH=false
